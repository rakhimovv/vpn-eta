root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# Tabs, matching every script in the repository.
[*.sh]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
# Trailing spaces are not used for line breaks here, but do not let an editor
# rewrap prose that is deliberately hard-wrapped at 96 columns.
max_line_length = 96
